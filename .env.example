# Web -> API, over loopback.
# Read by src/lib/api-base.ts (server components call the API directly) and by
# the /api/:path* rewrite in next.config.ts (browser calls go through the proxy).
# Must match the server's APP_PORT.
#
# 127.0.0.1 not localhost: Node prefers IPv6 ::1 while the API binds IPv4, which
# makes `localhost` fail intermittently with ECONNREFUSED.
INTERNAL_API_URL=http://127.0.0.1:4000

# Public origin of this web app.
# Used for metadataBase in app/layout.tsx, so OpenGraph images on the public
# event and check-in pages resolve to absolute URLs.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# OpenAPI Generator Configuration (npm run openapi:generate)
OPENAPI_INPUT=http://127.0.0.1:4000/api-docs-json
