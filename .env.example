# Web -> API, over loopback.
# Read by src/lib/api-base.ts (server components call the API directly) and by
# the /api/:path* rewrite in next.config.ts (browser calls go through the proxy).
# Must match the server's APP_PORT.
#
# 127.0.0.1 not localhost: Node prefers IPv6 ::1 while the API binds IPv4, which
# makes `localhost` fail intermittently with ECONNREFUSED.
INTERNAL_API_URL=http://127.0.0.1:4000

# Public origin of this web app.
# Used for metadataBase in app/layout.tsx, so OpenGraph images on the public
# event and check-in pages resolve to absolute URLs.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# OpenAPI Generator Configuration (npm run openapi:generate)
OPENAPI_INPUT=http://127.0.0.1:4000/api-docs-json

# Service worker: OFF unless this is exactly "1", in production as well as dev.
# Read at BUILD time (src/lib/pwa/config.ts), so changing it needs a rebuild.
#
# Off by default on purpose. A merge to main deploys itself, and a worker
# persists on user devices and answers before the network, so one shipped by
# accident is hard to take back. In development it also must stay off: sw.js
# serves /_next/static/ cache-first as immutable, which holds for content-hashed
# production filenames and not for Turbopack's dev chunk URLs.
# NEXT_PUBLIC_ENABLE_SW=1

# The kill switch. Read at REQUEST time by /sw-control, so it needs only a
# pm2 reload — no rebuild, no commit. Set to 1 and every worker tears itself
# down, deletes its caches and unregisters on the next load.
# deploy.yml never ships .env, so a value set on the instance survives deploys.
# PWA_DISABLE=1
